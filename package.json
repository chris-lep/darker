{
    "name": "darker",
    "version": "1.0.0",
    "private": true,
    "description": "Cinnamon panel applet that darkens the screen with a software overlay",
    "license": "GPL-3.0-or-later",
    "author": "chris-lep",
    "homepage": "https://github.com/chris-lep/darker#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chris-lep/darker.git"
    },
    "bugs": {
        "url": "https://github.com/chris-lep/darker/issues"
    },
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "test": "node --test \"test/**/*.test.js\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm test",
        "preversion": "npm run check",
        "version": "node scripts/version.js && git add CHANGELOG.md src/darker@chris-lep/metadata.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10"
    }
}
